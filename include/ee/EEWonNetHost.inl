#include "rust/won_lobby/wonnet.h"
#include "rust/won_net/reqdir.h"
#include "rust/won_net/routeop.h"
#include "rust/won_net/smartroute.h"
// The WON front end's host (R6 WON round 31): every call the Rust EEWonNet (ee_won_lobby wonnet.rs) makes on a C++
// object, one statement each, in the original's order (EeWonNetOp documents them). Included by EEWonNet.cpp and by
// tests/won/won_wonnet_test.cpp (over its stand-ins), so both run these very statements. Needs, in scope: EEWonNet,
// the completions' `Completion(call, routing)`, `WonRequests`, the statics `sEntities`, `sEntity`, `sFile`,
// `sProtocol`, `sRoomLine`, `sUpdateOp`, the sinks `WideOut`, `BytesOut`, `TextOut`, `DataOut`, `KeyValid`, and the
// game's globals the statements name.
static intptr_t WonNetHostCall(EEWonNet* w, EeWonNetOp inOp, intptr_t a, intptr_t b, intptr_t c, intptr_t d)
{
    typedef EeWonNetOp Op;
    switch (inOp) {
    case Op::LockCreate: ESVERIFY_AT(TSScheduler::CreateCriticalSection(w->mLock) == keseOK, 195); return 0;
    case Op::Lock8Create: ESVERIFY_AT(TSScheduler::CreateCriticalSection(w->mLock8) == keseOK, 197); return 0;
    case Op::LockDestroy: TSScheduler::DestroyCriticalSection(w->mLock); return 0;
    case Op::Lock8Destroy: TSScheduler::DestroyCriticalSection(w->mLock8); return 0;
    case Op::LockEnter: w->mLock->Enter(); return 0;
    case Op::LockLeave: w->mLock->Leave(); return 0;
    case Op::Lock8Enter: w->mLock8->Enter(); return 0;
    case Op::Lock8Leave: w->mLock8->Leave(); return 0;
    case Op::LobbyWindowExists: return w->mLobbyWindow != NULL;
    case Op::LobbyWindowClose: w->mLobbyWindow->Close(true); return 0;
    case Op::LobbyWindowClosed: return w->mLobbyWindow->mClosed;
    case Op::LobbyWindowDelete: delete w->mLobbyWindow; return 0;
    case Op::LobbyWindowVirtual18: w->mLobbyWindow->Virtual18(); return 0;
    case Op::LobbyDelete: delete w->mLobby; return 0;
    case Op::LobbyExists: return w->mLobby != NULL;
    case Op::LobbyPump: w->mLobby->Pump((unsigned long)a, 0); return 0;
    case Op::CancelledGet: return w->mCancelled;
    case Op::CancelledSet: w->mCancelled = a != 0; return 0;
    case Op::JoinRoomCancelledGet: return w->mJoinRoomCancelled;
    case Op::JoinRoomCancelledSet: w->mJoinRoomCancelled = a != 0; return 0;
    case Op::WonNetExists: return gWonNet != NULL;
    case Op::ClientIdSet: gWonClientId = (unsigned long)a; return 0;
    case Op::RoutingExists: return w->mRouting.get() != NULL;
    case Op::RoutingNew: w->mRouting = new SmartRoutingConnection; return 0;
    case Op::RoutingKill: w->mRouting->Kill(); return 0;
    case Op::RoutingClear: w->mRouting = NULL; return 0;
    case Op::RoutingSetAuth: w->mRouting->SetAuth(w->mUser, AUTH_TYPE_PERSISTENT); return 0;
    case Op::RoutingSetConnectCompletion: w->mRouting->SetConnectCompletion(Completion(a, false)); return 0;
    case Op::RoutingSetCloseCompletion: w->mRouting->SetCloseCompletion(Completion(a, false)); return 0;
    case Op::RoutingSetOpCompletion: w->mRouting->SetOpCompletion((int)a, Completion(b, true)); return 0;
    case Op::RoutingSetDefaultOpCompletion: w->mRouting->SetDefaultOpCompletion(Completion(a, true)); return 0;
    case Op::RoutingClearProductName: w->mRouting->ClearProductName(); return 0;
    case Op::RoutingConnect: w->mRouting->ConnectAsync(*(IPAddr*)a, 15000); return 0;
    case Op::RoutingMyClientId: return w->mRouting->GetMyClientId();
    case Op::RoutingIgnoreClient: w->mRouting->IgnoreClient((unsigned short)a, b != 0); return 0;
    case Op::DataLock: PlatMutexLock(w->mRouting->GetDataLock()); return 0;
    case Op::DataUnlock: PlatMutexUnlock(w->mRouting->GetDataLock()); return 0;
    case Op::StartGroupItr: w->mRouting->StartGroupItr(); return 0;
    case Op::StartMemberItr: return w->mRouting->StartMemberItr((unsigned short)a);
    case Op::SmartGet: return ee_won_smart_get(w->mRouting->mModel, (EeWonSmartGet)a, (unsigned short)b, 0, (EeWonSmartRecord*)c);
    case Op::SmartFind: ee_won_smart_find(w->mRouting->mModel, (const wchar_t*)a, (size_t)b, (EeWonSmartRecord*)c, (bool*)d); return 0;
    case Op::OpStatus: return ((AsyncOp*)a)->GetStatus();
    case Op::OpNum: return (intptr_t)((RoutingOp*)(AsyncOp*)a)->Num((int)b);
    case Op::OpType: return ((RoutingOp*)(AsyncOp*)a)->GetType();
    case Op::OpText: return WideOut(((RoutingOp*)(AsyncOp*)a)->Text((int)b), c);
    case Op::OpRecipientsEmpty: return ((RoutingOp*)(AsyncOp*)a)->Recipients().empty();
    case Op::OpData: return DataOut(((RoutingOp*)(AsyncOp*)a)->GetData(), b);
    case Op::OpRecords: ee_won_routeop_records(((RoutingOp*)(AsyncOp*)a)->mRust, (int)b, ee_won_wonnet_record, (void*)c); return 0;
    case Op::OpSocketIsRouting: return ((SocketOp*)(AsyncOp*)a)->GetSocket() == w->mRouting.get();
    case Op::OpPeerSocketIsRouting: return ((PeerAuthOp*)(AsyncOp*)a)->GetSocket() == w->mRouting.get();
    case Op::OpOnRouting: return ((RoutingOp*)(AsyncOp*)a)->mConnection.get() == w->mRouting.get();
    case Op::UserName: return WideOut(w->mUser->GetName(), a);
    case Op::TextLoad: return TextOut((long)a, b);
    case Op::Wcstombs: return (intptr_t)wcstombs((char*)a, (const wchar_t*)b, (size_t)c);
    case Op::ShowMessage: gEEWonNetUI.mDisplayMessage(UWideString((const char*)a), 1, NULL, NULL, true); return 0;
    case Op::ShowMessageLost: gEEWonNetUI.mDisplayMessage(UWideString((const char*)a), 1, NULL, CloseMessageCallback, true); return 0;
    case Op::ShowMessageHost: gEEWonNetUI.mDisplayMessage(UWideString((const char*)a), 1, reinterpret_cast<UIForm*>(w), HostGameCallback, true); return 0;
    case Op::ShowCancelConnect: gEEWonNetUI.mDisplayCancel(UWideString((const char*)a), 1, (UIForm*)&w->mCancelled, CancelConnectCallback, gUIManager->GetFormByID(b)); return 0;
    case Op::ShowCancelJoinRoom: gEEWonNetUI.mDisplayCancel(UWideString((const char*)a), 1, (UIForm*)&w->mJoinRoomCancelled, CancelConnectCallback, gUIManager->GetFormByID(b)); return 0;
    case Op::ShowCancelAccount: gEEWonNetUI.mDisplayCancel(UWideString((const char*)a), 1, (UIForm*)w->mAccountOp.get(), CancelOpCallback, gUIManager->GetFormByID(b)); return 0;
    case Op::SavePreferences: gEEWonNetUI.mSavePreferences(); return 0;
    case Op::SetHostedGameName: gHostedGameName = UWideString((const char*)a); return 0;
    case Op::FormById: return (intptr_t)gUIManager->GetFormByID(a);
    case Op::WideOut: ((std::wstring*)a)->assign((const wchar_t*)b, (size_t)c); return 0;
    case Op::CurrentForm: return (intptr_t)gUIManager->GetCurrentForm();
    case Op::FormControl: return (intptr_t)((UIForm*)a)->GetControl(b);
    case Op::CloseForm: gUserInterface->CloseForm((UIForm*)a); return 0;
    case Op::LockUi: gUIManager->LockUIForCopyData(); return 0;
    case Op::UnlockUi: gUIManager->UnlockUIForCopyData(); return 0;
    case Op::PopTo: gUIManager->PopTo((UIForm*)a); return 0;
    case Op::Push: gUIManager->Push((UIForm*)a); return 0;
    case Op::SwitchToForm: gUserInterface->SwitchToForm((UIForm*)a); return 0;
    case Op::NewRoomsOpenEvent: return (intptr_t)gEEWonNetUI.mNewRoomsOpenScreen();
    case Op::NewGamesOpenEvent: return (intptr_t)gEEWonNetUI.mNewGamesOpenScreen();
    case Op::FormSetOpenEvent: ((UIForm*)a)->SetFormOpenEvent((UIEvent*)b); return 0;
    case Op::EventDereference: ((UIEvent*)a)->Dereference(); return 0;
    case Op::CheckBoxChecked: return ((UICheckBox*)a)->GetIsChecked();
    case Op::CheckBoxSetChecked: ((UICheckBox*)a)->SetChecked(b != 0); return 0;
    case Op::EditBoxSetText: ((UIEditBox*)a)->SetText(UWideString((const char*)b)); return 0;
    case Op::LabelSetText: ((UITextLabel*)a)->SetText(UWideString((const char*)b)); return 0;
    case Op::NewJoinOrHost: return (intptr_t)static_cast<EEAction*>(new EEAJoinOrHostAGame(a, UWideString((const char*)b), UWideString((const char*)c)));
    case Op::NewWonGame: return (intptr_t)static_cast<EEAction*>(new EEAWonNet(3, UWideString((const char*)a), (long)b, (long)c, (d & 1) != 0, (d & 2) != 0, (d & 4) != 0));
    case Op::NewWonPlayer: return (intptr_t)static_cast<EEAction*>(new EEAWonNet(4, NULL, UWideString((const char*)a), false));
    case Op::NewWonChat: return (intptr_t)static_cast<EEAction*>(new EEAWonNet(a & 0xff, (UITextLabel*)b, UWideString((const char*)c), UWideString((const char*)d), (a >> 8) != 0));
    case Op::PostAction: gUserInterface->PostAction((EEAction*)a); return 0;
    case Op::ActionDereference: ((EEAction*)a)->Dereference(); return 0;
    case Op::PostLoginDone: gUserInterface->PostLoginDone(); return 0;
    case Op::RoomsBoxSelection: return ((EEUICWonNetRoomsBox*)a)->GetCurrentSelection(*(unsigned long*)b);
    case Op::RoomsBoxClear: ((EEUICWonNetRoomsBox*)a)->DeleteAllEntries(); return 0;
    case Op::RoomsBoxLineCount: return ((EEUICWonNetRoomsBox*)a)->GetLineCount();
    case Op::RoomsBoxSelect: ((EEUICWonNetRoomsBox*)a)->ChangeSelectionIndex((unsigned long)b, true, false); return 0;
    case Op::RoomsBoxAppend: ((EEUICWonNetRoomsBox*)a)->AppendLine(sRoomLine); return 0;
    case Op::RoomLineDescription: sRoomLine.mDescription = UWideString((const char*)a); return 0;
    case Op::RoomLineName: sRoomLine.mName = UWideString((const char*)a); return 0;
    case Op::RoomLinePlayers: sRoomLine.mNumPlayers = (long)a; return 0;
    case Op::RoomLineGames: sRoomLine.mNumGames = (long)a; return 0;
    case Op::ProtocolGet: NEProtocol::GetProtocol(0, sProtocol); return 0;
    case Op::ProtocolLocalAddress: return BytesOut(sProtocol->GetLocalAddress(gNetworkAdapter), a);
    case Op::ReqRegister: WonRequests(w->mRouting.get()).Register(gEmptyWideString, gEmptyWideString, gWonClientId, 0, 5, (unsigned long)a, Completion(b, true)); return 0;
    case Op::ReqSubscribe: WonRequests(w->mRouting.get()).SubscribeDataObject(0xffff, a ? kWonRoomObject : kWonGameObject, true, Completion(b, true)); return 0;
    case Op::ReqUnsubscribeGames: WonRequests(w->mRouting.get()).UnsubscribeDataObject(0xffff, kWonGameObject, true, NULL); return 0;
    case Op::ReqCreateGroup: WonRequests(w->mRouting.get()).CreateGroup(0xffff, (const wchar_t*)a, (const wchar_t*)b, 8, 0, true, 0, Completion(c, true)); return 0;
    case Op::ReqCreateGameObject: WonRequests(w->mRouting.get()).CreateDataObject(true, (unsigned short)a, kWonGameObject, (const wchar_t*)b, new ByteBuffer((const void*)c, (unsigned long)d, false), Completion((intptr_t)EeWonNetCall::JoinGameDataCallback, true)); return 0;
    case Op::ReqReplaceGameObject: WonRequests(w->mRouting.get()).ReplaceDataObject((unsigned short)a, kWonGameObject, (const wchar_t*)b, NULL); return 0;
    case Op::ReqModifyGameObject: WonRequests(w->mRouting.get()).ModifyDataObject((unsigned short)a, kWonGameObject, (const wchar_t*)b, 0, 0, new ByteBuffer((const void*)c, (unsigned long)d, false), NULL); return 0;
    case Op::ReqReadGameObject: WonRequests(w->mRouting.get()).ReadDataObject((unsigned short)a, kWonGameObject, true, Completion(b, true)); return 0;
    case Op::ReqJoinGroup: WonRequests(w->mRouting.get()).JoinGroup((unsigned short)a, (const wchar_t*)b, std::wstring(gEmptyWideString), 0, 0, Completion(c, true)); return 0;
    case Op::ReqCancelJoinGroup: WonRequests(w->mRouting.get()).CancelJoinGroup((unsigned short)a, true, NULL); return 0;
    case Op::ReqLeaveGroup: WonRequests(w->mRouting.get()).LeaveGroup((unsigned short)a, NULL); return 0;
    case Op::ReqGroupList: WonRequests(w->mRouting.get()).GetGroupList(0xff, Completion(a, true)); return 0;
    case Op::ReqClientList: WonRequests(w->mRouting.get()).GetClientList(Completion(a, true)); return 0;
    case Op::ReqMembers: WonRequests(w->mRouting.get()).GetMembersOfGroup((unsigned short)a, Completion(b, true)); return 0;
    case Op::ReqSendChat: WonRequests(w->mRouting.get()).SendChat((const wchar_t*)a, 0, (unsigned short)b, Completion(c, true)); return 0;
    case Op::ReqSendChatTo: WonRequests(w->mRouting.get()).SendChatTo((const wchar_t*)a, 4, std::list<unsigned short>((const unsigned short*)b, (const unsigned short*)b + c), NULL); return 0;
    case Op::KeyValid: return KeyValid();
    case Op::KeySave: CDKey(kWonProductName).SaveToRegistry(); return 0;
    case Op::LoginOpNew: w->mLoginOp = new GetCertOp(w->mUser); return 0;
    case Op::LoginOpSetCompletion: w->mLoginOp->SetCompletion(Completion(a, false)); return 0;
    case Op::LoginOpNoCreate: w->mLoginOp->SetCreateAccount(false); return 0;
    case Op::LoginOpRun: w->mLoginOp->RunAsync(15000); return 0;
    case Op::LoginOpIs: return (AsyncOp*)a == (AsyncOp*)w->mLoginOp.get();
    case Op::DirOpNew: w->mDirOp = RustServerOp::NewGetDir(w->mDirServers.get(), kWonProductDirectory, 0x703003a); return 0;
    case Op::DirOpSetCompletion: w->mDirOp->SetCompletion(Completion(a, false)); return 0;
    case Op::DirOpRun: w->mDirOp->RunAsync(15000); return 0;
    case Op::DirOpIs: return (AsyncOp*)a == (AsyncOp*)w->mDirOp.get();
    case Op::ServersClear: w->mServers.clear(); return 0;
    case Op::EntitiesLoad: sEntities = ((RustServerOp*)(AsyncOp*)a)->GetEntities(EE_WON_REQOP_DIR_LIST); return 0;
    case Op::EntityFirst: sEntity = 0; return 0;
    case Op::EntityAtEnd: return sEntity == sEntities.size();
    case Op::EntityIsRouting: return sEntities.Name(sEntity) == kWonRoutingServerType;
    case Op::EntityKeep: w->mServers.Keep(sEntities, sEntity); return 0;
    case Op::EntityNext: sEntity++; return 0;
    case Op::FileSetVolume: sFile.SetVolume(gStartupVolume); return 0;
    case Op::FileSetDirectory: sFile.SetDirectory(gStartupDirectory); return 0;
    case Op::FileSetName: sFile.SetFile(UString("SierraCom.cfg")); return 0;
    case Op::FileOpen: return sFile.FOpen("r") == 0;
    case Op::FileGets: return fgets((char*)a, 256, sFile) != NULL;
    case Op::FileClose: sFile.Close(); return 0;
    case Op::DirServersNew: w->mDirServers = new ServerContext; return 0;
    case Op::DirServersAdd: w->mDirServers->AddAddress(IPAddr(std::string((const char*)a))); return 0;
    case Op::UpdateOpNew: sUpdateOp = RustServerOp::NewUpdateAccount(w->mAuthServers, w->mUser, (const wchar_t*)a, std::string((const char*)b)); return 0;
    case Op::UpdateOpSetCompletion: sUpdateOp->SetCompletion(Completion(a, false)); return 0;
    case Op::UpdateOpClearNewsletters: sUpdateOp->SetNum(EE_WON_REQOP_ACCOUNT_CLEAR_NEWSLETTERS, 0); return 0;
    case Op::UpdateOpNewsletter: sUpdateOp->SetNum(EE_WON_REQOP_ACCOUNT_NEWSLETTER, a); return 0;
    case Op::UpdateOpRun: sUpdateOp->RunAsync(15000); return 0;
    case Op::UpdateOpRelease: sUpdateOp = NULL; return 0;
    case Op::AccountOpNew: w->mAccountOp = RustServerOp::NewGetAccount(w->mAuthServers, w->mUser); return 0;
    case Op::AccountOpSetCompletion: w->mAccountOp->SetCompletion(Completion(a, false)); return 0;
    case Op::AccountOpRun: w->mAccountOp->RunAsync(15000); return 0;
    case Op::AccountOpNewsletter: w->mAccountOp->SetNum(EE_WON_REQOP_ACCOUNT_NEWSLETTER, 1); return 0;
    case Op::AccountNewsletter: return (intptr_t)((RustServerOp*)(AsyncOp*)a)->GetNum(EE_WON_REQOP_ACCOUNT_NEWSLETTER, 1);
    case Op::AccountEmail: return BytesOut(((RustServerOp*)(AsyncOp*)a)->GetBytes(EE_WON_REQOP_ACCOUNT_EMAIL), b);
    case Op::InfoName: return (intptr_t)(const char*)((EEWonNetGameInfo*)a)->mGameName;
    case Op::InfoAddress: return (intptr_t)(const char*)((EEWonNetGameInfo*)a)->mAddress;
    case Op::InfoPassword: return (intptr_t)(const char*)((EEWonNetGameInfo*)a)->mPassword;
    case Op::InfoHumans: return ((EEWonNetGameInfo*)a)->mHumans;
    case Op::InfoPlayers: return ((EEWonNetGameInfo*)a)->mPlayers;
    case Op::InfoHost: return ((EEWonNetGameInfo*)a)->mHostClientId;
    case Op::InfoFlags: return ((EEWonNetGameInfo*)a)->mFlags;
    case Op::InfoRoom: return ((EEWonNetGameInfo*)a)->mRoomGroupId;
    case Op::InfoSetName: ((EEWonNetGameInfo*)a)->mGameName = (const char*)b; return 0;
    case Op::InfoSetAddress: ((EEWonNetGameInfo*)a)->mAddress = (const char*)b; return 0;
    case Op::InfoSetPassword: ((EEWonNetGameInfo*)a)->mPassword = (const char*)b; return 0;
    case Op::InfoSetHumans: ((EEWonNetGameInfo*)a)->mHumans = (uint32_t)b; return 0;
    case Op::InfoSetPlayers: ((EEWonNetGameInfo*)a)->mPlayers = (uint32_t)b; return 0;
    case Op::InfoSetHost: ((EEWonNetGameInfo*)a)->mHostClientId = (uint32_t)b; return 0;
    case Op::InfoSetFlags: ((EEWonNetGameInfo*)a)->mFlags = (uint32_t)b; return 0;
    case Op::InfoSetRoom: ((EEWonNetGameInfo*)a)->mRoomGroupId = (unsigned short)b; return 0;
